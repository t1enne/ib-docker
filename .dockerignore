# Docker ignore file for IBKR Client Portal Gateway

# Git
.git
.gitignore

# Documentation
README.md
*.md

# Environment files
.env
.env.*

# Data directories
data/
logs/

# Certificates (if using custom ones)
certs/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/

# Examples (not needed in container)
examples/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp