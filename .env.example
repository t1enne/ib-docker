# Environment variables for IBKR Client Portal Gateway Docker container
# Copy this file to .env and modify as needed

# Java Virtual Machine options
JAVA_OPTS=-Xmx512m -Djava.security.egd=file:/dev/./urandom

# Gateway port (default: 5000)
GATEWAY_PORT=5000

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Session timeout in seconds (default: 86400 = 24 hours)
SESSION_TIMEOUT=86400

# Re-authentication timeout in seconds (default: 120 = 2 minutes)
REAUTH_TIMEOUT=120

# SSL Certificate path (relative to container)
SSL_CERT_PATH=cacert.pem

# Enable/disable SSL (true/false)
SSL_ENABLED=true

# CORS settings
CORS_ORIGIN=*
CORS_HEADERS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true